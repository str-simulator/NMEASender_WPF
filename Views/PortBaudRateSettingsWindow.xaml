<Window x:Class="NMEASender.Wpf.PortBaudRateSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="560"
        Height="680"
        MinWidth="460"
        MinHeight="520"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Text="Output Settings" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#5F6B84"
                       Text="Configure COM baud rate and UDP port per sentence." />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="10"
                Background="#F9FBFF"
                BorderBrush="#D8DEE9"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Margin="0,0,0,10"
                            Padding="10"
                            Background="White"
                            BorderBrush="#DFE5F0"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Text="COM Port BaudRate" />

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding PortBaudRates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding PortName}" />
                                            <ComboBox Grid.Column="1"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding DataContext.BaudRateOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding BaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Padding="10"
                            Background="White"
                            BorderBrush="#DFE5F0"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Text="Sentence UDP Port" />

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding SentenceUdpPorts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="#5C6A85"
                                                       Text="{Binding RowKey}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding SentenceLabel}" />
                                            <TextBox Grid.Column="2"
                                                     VerticalAlignment="Center"
                                                     HorizontalContentAlignment="Right"
                                                     Text="{Binding UdpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Foreground="#C62828"
                       Text="{Binding ValidationMessage}" />
            <Button Grid.Column="1"
                    Width="90"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel" />
            <Button Grid.Column="2"
                    Width="90"
                    Command="{Binding SaveCommand}"
                    Content="Save" />
        </Grid>
    </Grid>
</Window>
