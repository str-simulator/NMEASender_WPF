<UserControl x:Class="NMEASender.Wpf.Views.Panels.SentencePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:NMEASender.Wpf.Behaviors.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="900"
             d:DesignWidth="1200"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="SentenceRowTemplate">
            <Grid Style="{StaticResource SentenceRowGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"
                                      MinWidth="32"
                                      SharedSizeGroup="AddColumn" />
                    <ColumnDefinition Width="Auto"
                                      MinWidth="86"
                                      SharedSizeGroup="SentenceColumn" />
                    <ColumnDefinition Width="Auto"
                                      MinWidth="56"
                                      SharedSizeGroup="UseComColumn" />
                    <ColumnDefinition Width="Auto"
                                      MinWidth="56"
                                      SharedSizeGroup="UseUdpColumn" />
                    <ColumnDefinition Width="Auto"
                                      MinWidth="104"
                                      SharedSizeGroup="ComPortColumn" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="Auto"
                                      MinWidth="270"
                                      SharedSizeGroup="SecondaryColumn" />
                </Grid.ColumnDefinitions>

                <Button x:Name="AddRowButton"
                        Grid.Column="0"
                        Command="{Binding DataContext.AddSentenceRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding DataContext.IsComSettingsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource SentenceAddButtonStyle}">
                    <Viewbox Width="10"
                             Height="10"
                             Stretch="Fill">
                        <Canvas Width="10" Height="10">
                            <Rectangle Canvas.Left="4"
                                       Width="1"
                                       Height="10"
                                       Fill="SkyBlue" />
                            <Rectangle Canvas.Top="4"
                                       Width="10"
                                       Height="1"
                                       Fill="SkyBlue" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="RemoveRowButton"
                        Grid.Column="0"
                        Command="{Binding DataContext.RemoveSentenceRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding DataContext.IsComSettingsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource SentenceRemoveButtonStyle}"
                        Visibility="Collapsed">
                    <Viewbox Width="10"
                             Height="10"
                             Stretch="Fill">
                        <Canvas Width="10" Height="10">
                            <Rectangle Canvas.Top="4"
                                       Width="10"
                                       Height="1"
                                       Fill="IndianRed" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <TextBlock Grid.Column="1"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource TableHeaderTextStyle}"
                           Text="{Binding Label}" />
                <CheckBox Grid.Column="2"
                          Margin="0,0,8,0"
                          HorizontalAlignment="Center"
                          IsChecked="{Binding IsComEnabled}" />
                <CheckBox Grid.Column="3"
                          Margin="0,0,8,0"
                          HorizontalAlignment="Center"
                          IsChecked="{Binding IsUdpEnabled}" />
                <ComboBox Grid.Column="4"
                          Width="96"
                          Margin="0,0,10,0"
                          behaviors:ComboBoxDropDownCommandBehavior.Command="{Binding DataContext.RefreshPortsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          IsEditable="False"
                          IsEnabled="{Binding DataContext.IsComSettingsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          ItemsSource="{Binding DataContext.Ports, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding PortName, Mode=TwoWay}" />
                <TextBox x:Name="PrimaryBox"
                         Grid.Column="5"
                         Margin="0,0,10,0"
                         IsReadOnly="True"
                         Style="{StaticResource SentenceTextBoxStyle}"
                         Text="{Binding PrimaryText}" />
                <TextBox Grid.Column="6"
                         Width="270"
                         IsReadOnly="True"
                         Style="{StaticResource SentenceTextBoxStyle}"
                         Text="{Binding SecondaryText}"
                         Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasSecondary}" Value="False">
                    <Setter TargetName="PrimaryBox" Property="Grid.ColumnSpan" Value="2" />
                    <Setter TargetName="PrimaryBox" Property="Margin" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDuplicateRow}" Value="True">
                    <Setter TargetName="AddRowButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RemoveRowButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="10,8"
                Style="{StaticResource TableHeaderBorderStyle}">
            <StackPanel Orientation="Horizontal">
                <CheckBox Margin="0,0,16,0"
                          Content="ALL COM Check"
                          IsChecked="{Binding AreAllComSentencesChecked, Mode=TwoWay}" />
                <CheckBox Content="ALL UDP Check" IsChecked="{Binding AreAllUdpSentencesChecked, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="1" Header="GPS Sentence">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource TableHeaderBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              MinWidth="32"
                                              SharedSizeGroup="AddColumn" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="86"
                                              SharedSizeGroup="SentenceColumn" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="56"
                                              SharedSizeGroup="UseComColumn" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="56"
                                              SharedSizeGroup="UseUdpColumn" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="104"
                                              SharedSizeGroup="ComPortColumn" />
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="270"
                                              SharedSizeGroup="SecondaryColumn" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource TableHeaderTextStyle}"
                                   Text="+" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource TableHeaderTextStyle}"
                                   Text="Sentence" />
                        <TextBlock Grid.Column="2"
                                   Grid.ColumnSpan="2"
                                   Margin="0,0,10,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource TableHeaderTextStyle}"
                                   Text="Use COM/UDP" />
                        <TextBlock Grid.Column="4"
                                   Margin="0,0,10,0"
                                   Style="{StaticResource TableHeaderTextStyle}"
                                   Text="COM" />
                        <TextBlock Grid.Column="5"
                                   Margin="0,0,10,0"
                                   Style="{StaticResource TableHeaderTextStyle}"
                                   Text="NMEA #1" />
                        <TextBlock Grid.Column="6"
                                   Style="{StaticResource TableHeaderTextStyle}"
                                   Text="NMEA #2" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1"
                              Height="190"
                              CanContentScroll="True"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style BasedOn="{StaticResource LogScrollBarStyle}" TargetType="{x:Type ScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl ItemTemplate="{StaticResource SentenceRowTemplate}" ItemsSource="{Binding GpsSentencesView}" />
                </ScrollViewer>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Margin="0"
                  Header="Other Sentence">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource TableHeaderBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              MinWidth="32"
                                              SharedSizeGroup="AddColumn" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="86"
                                              SharedSizeGroup="SentenceColumn" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="56"
                                              SharedSizeGroup="UseComColumn" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="56"
                                              SharedSizeGroup="UseUdpColumn" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="104"
                                              SharedSizeGroup="ComPortColumn" />
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="270"
                                              SharedSizeGroup="SecondaryColumn" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource TableHeaderTextStyle}"
                                   Text="+" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource TableHeaderTextStyle}"
                                   Text="Sentence" />
                        <TextBlock Grid.Column="2"
                                   Grid.ColumnSpan="2"
                                   Margin="0,0,10,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource TableHeaderTextStyle}"
                                   Text="Use COM/UDP" />
                        <TextBlock Grid.Column="4"
                                   Margin="0,0,10,0"
                                   Style="{StaticResource TableHeaderTextStyle}"
                                   Text="COM" />
                        <TextBlock Grid.Column="5"
                                   Margin="0,0,10,0"
                                   Style="{StaticResource TableHeaderTextStyle}"
                                   Text="NMEA #1" />
                        <TextBlock Grid.Column="6"
                                   Style="{StaticResource TableHeaderTextStyle}"
                                   Text="NMEA #2" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style BasedOn="{StaticResource LogScrollBarStyle}" TargetType="{x:Type ScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl ItemTemplate="{StaticResource SentenceRowTemplate}" ItemsSource="{Binding OtherSentencesView}" />
                </ScrollViewer>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
