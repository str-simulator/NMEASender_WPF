<UserControl x:Class="NMEASender.Wpf.Views.Panels.TopToolbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:NMEASender.Wpf.Behaviors.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="80"
             d:DesignWidth="1200"
             mc:Ignorable="d">
    <Border Style="{StaticResource ToolbarContainerStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding StartCommand}"
                    Style="{StaticResource PrimaryButtonStyle}">
                <TextBlock Foreground="White" Text="START" />
            </Button>
            <Button Grid.Column="1"
                    Margin="8,0,18,0"
                    Command="{Binding StopCommand}"
                    Style="{StaticResource DangerButtonStyle}">
                <TextBlock Foreground="White" Text="STOP" />
            </Button>
            <TextBlock Grid.Column="2"
                       Style="{StaticResource ToolbarLabelTextStyle}"
                       Text="COM" />
            <ComboBox Grid.Column="3"
                      Width="96"
                      behaviors:ComboBoxDropDownCommandBehavior.Command="{Binding RefreshPortsCommand}"
                      IsEditable="False"
                      IsEnabled="{Binding IsComSettingsEditable}"
                      ItemsSource="{Binding Ports}"
                      SelectedItem="{Binding DefaultPort, Mode=TwoWay}" />
            <Button Grid.Column="4"
                    Margin="8,0,20,0"
                    Command="{Binding ApplyDefaultPortCommand}"
                    Content="APPLY"
                    Style="{StaticResource ToolbarButtonStyle}" />

            <StackPanel Grid.Column="5"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock Style="{StaticResource ToolbarLabelTextStyle}" Text="Source" />
                <RadioButton Content="By IOS"
                             GroupName="Source"
                             IsChecked="{Binding IsIosSource}" />
                <RadioButton Margin="12,0,0,0"
                             Content="TEST"
                             GroupName="Source"
                             IsChecked="{Binding IsTestSource}" />
            </StackPanel>

            <StackPanel Grid.Column="6"
                        Margin="30,0,30,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <CheckBox Content="TRUE"
                          IsChecked="{Binding UseTrueWind}"
                          Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Column="7"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock Style="{StaticResource ToolbarLabelTextStyle}" Text="UDP" />
                <TextBox Width="78"
                         Margin="8,0,0,0"
                         Text="{Binding UdpPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Margin="8,0,0,0"
                        Command="{Binding ApplyDefaultUdpPortCommand}"
                        Content="APPLY"
                        Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="9"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBox Width="210"
                         Text="{Binding SentenceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search sentence" />
                <Button Width="28"
                        MinWidth="28"
                        Margin="6,0,0,0"
                        Padding="0"
                        Command="{Binding ClearSentenceSearchCommand}"
                        Content="x"
                        Visibility="{Binding HasSentenceSearchText, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <Button Grid.Column="10"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    Command="{Binding OpenSettingsCommand}"
                    Content="Settings"
                    Style="{StaticResource ToolbarButtonStyle}" />

            <Button Grid.Column="11"
                    HorizontalAlignment="Right"
                    Command="{Binding ExitCommand}"
                    Content="EXIT"
                    Style="{StaticResource ToolbarButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
