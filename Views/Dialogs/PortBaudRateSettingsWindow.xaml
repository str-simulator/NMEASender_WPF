<Window x:Class="NMEASender.Wpf.Views.Dialogs.PortBaudRateSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="800"
        Height="720"
        MinWidth="640"
        MinHeight="520"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Text="Output Settings" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#5F6B84"
                       Text="Configure COM baud rate, UDP transport mode, and sentence UDP endpoints." />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="10"
                Background="#F9FBFF"
                BorderBrush="#D8DEE9"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style BasedOn="{StaticResource LogScrollBarStyle}" TargetType="{x:Type ScrollBar}" />
                </ScrollViewer.Resources>
                <StackPanel>
                    <Border Margin="0,0,0,10"
                            Padding="10"
                            Background="White"
                            BorderBrush="#DFE5F0"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Text="COM Port BaudRate" />

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding PortBaudRates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding PortName}" />
                                            <ComboBox Grid.Column="1"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding DataContext.BaudRateOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding BaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Margin="0,0,0,10"
                            Padding="10"
                            Background="White"
                            BorderBrush="#DFE5F0"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Text="UDP Transport" />

                            <StackPanel Grid.Row="1"
                                        Margin="0,0,0,8"
                                        Orientation="Horizontal">
                                <RadioButton Content="Broadcast"
                                             GroupName="UdpTransportMode"
                                             IsChecked="{Binding IsBroadcastMode, Mode=TwoWay}" />
                                <RadioButton Margin="16,0,0,0"
                                             Content="Multicast"
                                             GroupName="UdpTransportMode"
                                             IsChecked="{Binding IsMulticastMode, Mode=TwoWay}" />
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#5C6A85"
                                           Text="UDP Port" />
                                <TextBox Grid.Column="1"
                                         Margin="8,0,8,0"
                                         Text="{Binding UdpPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2"
                                        Width="70"
                                        Command="{Binding ApplyUdpPortToAllCommand}"
                                        Content="APPLY"
                                        Style="{StaticResource ToolbarButtonStyle}" />
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#5C6A85"
                                           Text="Multicast Address" />
                                <TextBox Grid.Column="1"
                                         Margin="8,0,0,0"
                                         IsEnabled="{Binding IsMulticastAddressEditable}"
                                         Text="{Binding MulticastAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <TextBlock Grid.Row="4"
                                       Margin="0,8,0,0"
                                       Foreground="#6E7A90"
                                       Text="Multicast address must be an IPv4 address in the range 224.0.0.0 - 239.255.255.255." />

                        </Grid>
                    </Border>

                    <Border Padding="10"
                            Background="White"
                            BorderBrush="#DFE5F0"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Text="Sentence UDP Endpoint, Hz &amp; Talker ID" />

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <TextBox Padding="26,0,8,0"
                                         Text="{Binding SentenceUdpSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search sentence endpoint" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="#7B879B"
                                           IsHitTestVisible="False"
                                           Text="&#xE721;" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="2"
                                           Margin="0,0,8,0"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="#7B879B"
                                           Text="UDP Port" />
                                <TextBlock Grid.Column="3"
                                           FontSize="11"
                                           Foreground="#7B879B"
                                           Text="Address" />
                                <TextBlock Grid.Column="4"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="#7B879B"
                                           Text="Hz" />
                                <TextBlock Grid.Column="5"
                                           Margin="8,0,0,0"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="#7B879B"
                                           Text="Talker ID" />
                            </Grid>

                            <ItemsControl Grid.Row="3" ItemsSource="{Binding FilteredSentenceUdpPorts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="#5C6A85"
                                                       Text="{Binding RowKey}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding SentenceLabel}" />
                                            <TextBox Grid.Column="2"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     HorizontalContentAlignment="Right"
                                                     Text="{Binding UdpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="3"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     IsEnabled="{Binding DataContext.IsSentenceMulticastAddressEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Text="{Binding UdpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="4"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     HorizontalContentAlignment="Right"
                                                     Text="{Binding Hz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="5"
                                                     VerticalAlignment="Center"
                                                     HorizontalContentAlignment="Right"
                                                     MaxLength="2"
                                                     Text="{Binding TalkerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Foreground="#C62828"
                       Text="{Binding ValidationMessage}" />
            <Button Grid.Column="1"
                    Width="90"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel" />
            <Button Grid.Column="2"
                    Width="90"
                    Command="{Binding SaveCommand}"
                    Content="Save" />
        </Grid>
    </Grid>
</Window>
