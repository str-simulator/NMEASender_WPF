<Application x:Class="NMEASender.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NMEASender.Wpf.ViewModels"
             xmlns:views="clr-namespace:NMEASender.Wpf.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type viewModels:TopToolbarViewModel}">
                <views:TopToolbarView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ManualLogViewModel}">
                <views:ManualLogView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:SentencePanelViewModel}">
                <views:SentencePanelView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
