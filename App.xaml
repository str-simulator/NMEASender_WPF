<Application x:Class="NMEASender.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panelViewModels="clr-namespace:NMEASender.Wpf.ViewModels.Panels"
             xmlns:panelViews="clr-namespace:NMEASender.Wpf.Views.Panels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type panelViewModels:TopToolbarViewModel}">
                <panelViews:TopToolbarView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type panelViewModels:ManualLogViewModel}">
                <panelViews:ManualLogView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type panelViewModels:SentencePanelViewModel}">
                <panelViews:SentencePanelView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
