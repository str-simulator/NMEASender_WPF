<Window x:Class="NMEASender.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NMEASender.Wpf.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="NMEA Sender"
        Width="1800"
        Height="1080"
        MinWidth="1280"
        MinHeight="860"
        Background="{StaticResource AppBackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:TopToolbarView Grid.Row="0" Margin="0,0,0,14" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="600" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:ManualLogView Grid.Column="0" Margin="0,0,14,0" />
            <views:SentencePanelView Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
