<Window x:Class="NMEASender.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:NMEASender.Wpf.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="NMEA Sender"
        Width="1800"
        Height="1080"
        MinWidth="1280"
        MinHeight="860"
        Background="{StaticResource AppBackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Window.Resources>
        <DataTemplate x:Key="SentenceRowTemplate">
            <Grid Style="{StaticResource SentenceRowGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"
                                      MinWidth="32"
                                      SharedSizeGroup="AddColumn" />
                    <ColumnDefinition Width="Auto"
                                      MinWidth="86"
                                      SharedSizeGroup="SentenceColumn" />
                    <ColumnDefinition Width="Auto"
                                      MinWidth="104"
                                      SharedSizeGroup="ComColumn" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="Auto"
                                      MinWidth="270"
                                      SharedSizeGroup="SecondaryColumn" />
                </Grid.ColumnDefinitions>

                <Button x:Name="AddRowButton"
                        Grid.Column="0"
                        Command="{Binding DataContext.AddSentenceRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding DataContext.IsComSettingsEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource SentenceAddButtonStyle}">
                    <Viewbox Width="10"
                             Height="10"
                             Stretch="Fill">
                        <Canvas Width="10" Height="10">
                            <Rectangle Canvas.Left="4"
                                       Width="1"
                                       Height="10"
                                       Fill="SkyBlue" />
                            <Rectangle Canvas.Top="4"
                                       Width="10"
                                       Height="1"
                                       Fill="SkyBlue" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="RemoveRowButton"
                        Grid.Column="0"
                        Command="{Binding DataContext.RemoveSentenceRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding DataContext.IsComSettingsEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource SentenceRemoveButtonStyle}"
                        Visibility="Collapsed">
                    <Viewbox Width="10"
                             Height="10"
                             Stretch="Fill">
                        <Canvas Width="10" Height="10">
                            <Rectangle Canvas.Top="4"
                                       Width="10"
                                       Height="1"
                                       Fill="IndianRed" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <CheckBox Grid.Column="1"
                          Margin="0,0,8,0"
                          Content="{Binding Label}"
                          IsChecked="{Binding IsEnabled}" />
                <ComboBox Grid.Column="2"
                          Width="96"
                          Margin="0,0,10,0"
                          behaviors:ComboBoxDropDownCommandBehavior.Command="{Binding DataContext.RefreshPortsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          IsEditable="False"
                          IsEnabled="{Binding DataContext.IsComSettingsEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                          ItemsSource="{Binding DataContext.Ports, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding PortName, Mode=TwoWay}" />
                <TextBox x:Name="PrimaryBox"
                         Grid.Column="3"
                         Margin="0,0,10,0"
                         IsReadOnly="True"
                         Style="{StaticResource SentenceTextBoxStyle}"
                         Text="{Binding PrimaryText}" />
                <TextBox Grid.Column="4"
                         Width="270"
                         IsReadOnly="True"
                         Style="{StaticResource SentenceTextBoxStyle}"
                         Text="{Binding SecondaryText}"
                         Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasSecondary}" Value="False">
                    <Setter TargetName="PrimaryBox" Property="Grid.ColumnSpan" Value="2" />
                    <Setter TargetName="PrimaryBox" Property="Margin" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDuplicateRow}" Value="True">
                    <Setter TargetName="AddRowButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RemoveRowButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Style="{StaticResource ToolbarContainerStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding StartCommand}"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <TextBlock Foreground="White" Text="START" />
                </Button>
                <Button Grid.Column="1"
                        Margin="8,0,18,0"
                        Command="{Binding StopCommand}"
                        Style="{StaticResource DangerButtonStyle}">
                    <TextBlock Foreground="White" Text="STOP" />
                </Button>
                <TextBlock Grid.Column="2"
                           Style="{StaticResource ToolbarLabelTextStyle}"
                           Text="COM" />
                <ComboBox Grid.Column="3"
                          Width="96"
                          behaviors:ComboBoxDropDownCommandBehavior.Command="{Binding RefreshPortsCommand}"
                          IsEditable="False"
                          IsEnabled="{Binding IsComSettingsEditable}"
                          ItemsSource="{Binding Ports}"
                          SelectedItem="{Binding DefaultPort, Mode=TwoWay}" />
                <Button Grid.Column="4"
                        Margin="8,0,20,0"
                        Command="{Binding ApplyDefaultPortCommand}"
                        Content="APPLY"
                        Style="{StaticResource ToolbarButtonStyle}" />

                <StackPanel Grid.Column="5"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolbarLabelTextStyle}" Text="Source" />
                    <RadioButton Content="By IOS"
                                 GroupName="Source"
                                 IsChecked="{Binding IsIosSource}" />
                    <RadioButton Margin="12,0,0,0"
                                 Content="TEST"
                                 GroupName="Source"
                                 IsChecked="{Binding IsTestSource}" />
                </StackPanel>

                <StackPanel Grid.Column="6"
                            Margin="30,0,30,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <CheckBox Content="TRUE"
                              IsChecked="{Binding UseTrueWind}"
                              Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="7"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <CheckBox Content="Use UDP" IsChecked="{Binding UseUdp}" />
                    <TextBox Width="78"
                             Margin="8,0,0,0"
                             IsEnabled="{Binding UseUdp}"
                             Text="{Binding UdpPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="9"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        Command="{Binding OpenSettingsCommand}"
                        Content="Settings"
                        Style="{StaticResource ToolbarButtonStyle}" />

                <Button Grid.Column="10"
                        HorizontalAlignment="Right"
                        Command="{Binding ExitCommand}"
                        Content="EXIT"
                        Style="{StaticResource ToolbarButtonStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="600" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,14,0"
                    Style="{StaticResource PanelSurfaceStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Text="Manual Data" />

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource ManualFieldLabelTextStyle}"
                                   Text="Longitude" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Style="{StaticResource ManualFieldTextBoxStyle}"
                                 Text="{Binding LongitudeText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource ManualFieldLabelTextStyle}"
                                   Text="Latitude" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Style="{StaticResource ManualFieldTextBoxStyle}"
                                 Text="{Binding LatitudeText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2"
                                   Style="{StaticResource ManualFieldLabelTextStyle}"
                                   Text="Speed" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Style="{StaticResource ManualFieldTextBoxStyle}"
                                 Text="{Binding SpeedText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3"
                                   Style="{StaticResource ManualFieldLabelTextStyle}"
                                   Text="Heading" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Style="{StaticResource ManualFieldTextBoxStyle}"
                                 Text="{Binding HeadingText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,16,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding GetDataCommand}"
                                Content="Get Data"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <Button Grid.Column="2"
                                Command="{Binding SetDataCommand}"
                                Content="Set Data"
                                Style="{StaticResource ToolbarButtonStyle}" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock HorizontalAlignment="Left"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Text="Log" />
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding ClearLogCommand}"
                                    Content="Clear"
                                    Style="{StaticResource ToolbarButtonStyle}" />
                        </Grid>
                        <ListBox x:Name="LogListBox"
                                 Grid.Row="1"
                                 MinHeight="260"
                                 behaviors:ListBoxAutoFollowBehavior.IsEnabled="True"
                                 ItemsSource="{Binding Logs}"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="False" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,8"
                        Padding="10,8"
                        Style="{StaticResource TableHeaderBorderStyle}">
                    <CheckBox Content="ALL Sentence Check" IsChecked="{Binding AreAllSentencesChecked, Mode=TwoWay}" />
                </Border>

                <GroupBox Grid.Row="1" Header="GPS Sentence">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource TableHeaderBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"
                                                      MinWidth="32"
                                                      SharedSizeGroup="AddColumn" />
                                    <ColumnDefinition Width="Auto"
                                                      MinWidth="86"
                                                      SharedSizeGroup="SentenceColumn" />
                                    <ColumnDefinition Width="Auto"
                                                      MinWidth="104"
                                                      SharedSizeGroup="ComColumn" />
                                    <ColumnDefinition Width="*" MinWidth="260" />
                                    <ColumnDefinition Width="Auto"
                                                      MinWidth="270"
                                                      SharedSizeGroup="SecondaryColumn" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Text="+" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Text="Sentence" />
                                <TextBlock Grid.Column="2"
                                           Margin="0,0,10,0"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Text="COM" />
                                <TextBlock Grid.Column="3"
                                           Margin="0,0,10,0"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Text="NMEA #1" />
                                <TextBlock Grid.Column="4"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Text="NMEA #2" />
                            </Grid>
                        </Border>
                        <ItemsControl Grid.Row="1"
                                      ItemTemplate="{StaticResource SentenceRowTemplate}"
                                      ItemsSource="{Binding GpsSentences}" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="2"
                          Margin="0"
                          Header="Other Sentence">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource TableHeaderBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"
                                                      MinWidth="32"
                                                      SharedSizeGroup="AddColumn" />
                                    <ColumnDefinition Width="Auto"
                                                      MinWidth="86"
                                                      SharedSizeGroup="SentenceColumn" />
                                    <ColumnDefinition Width="Auto"
                                                      MinWidth="104"
                                                      SharedSizeGroup="ComColumn" />
                                    <ColumnDefinition Width="*" MinWidth="260" />
                                    <ColumnDefinition Width="Auto"
                                                      MinWidth="270"
                                                      SharedSizeGroup="SecondaryColumn" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Text="+" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Text="Sentence" />
                                <TextBlock Grid.Column="2"
                                           Margin="0,0,10,0"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Text="COM" />
                                <TextBlock Grid.Column="3"
                                           Margin="0,0,10,0"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Text="NMEA #1" />
                                <TextBlock Grid.Column="4"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Text="NMEA #2" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style BasedOn="{StaticResource LogScrollBarStyle}" TargetType="{x:Type ScrollBar}" />
                            </ScrollViewer.Resources>
                            <ItemsControl ItemTemplate="{StaticResource SentenceRowTemplate}" ItemsSource="{Binding OtherSentences}" />
                        </ScrollViewer>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>

